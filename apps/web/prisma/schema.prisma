generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Better Auth's tables (email and password only, ADR 0005). Its sign-in
// session is AuthSession, so the domain's Session keeps its glossary name.

model User {
  id                    String             @id
  name                  String
  email                 String             @unique
  emailVerified         Boolean            @default(false)
  image                 String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  authSessions          AuthSession[]
  accounts              Account[]
  collectionMemberships CollectionMember[]
  overallRatings        OverallRating[]

  @@map("user")
}

model AuthSession {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Collecting.

// A Collection has no owner column: who may see or change it is decided only
// by its CollectionMember rows, so households can add members later.
model Collection {
  id        String             @id @default(uuid(7))
  name      String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  members   CollectionMember[]
  levels    Level[]
  items     Item[]

  @@map("collection")
}

enum CollectionMemberRole {
  owner

  @@map("collection_member_role")
}

model CollectionMember {
  id           String               @id @default(uuid(7))
  collectionId String
  collection   Collection           @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  userId       String
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         CollectionMemberRole
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([collectionId, userId])
  @@index([userId])
  @@map("collection_member")
}

// Positions are contiguous from 0 (the top Level). Its Verdict belongs to the
// Level's Overall form, so a Session form Verdict can sit beside it later.
model Level {
  id                  String     @id @default(uuid(7))
  collectionId        String
  collection          Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  name                String
  position            Int
  overallVerdictName  String
  // A VerdictScale from @repo/shared, parsed with its schema when read.
  overallVerdictScale Json
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  items               Item[]

  @@unique([collectionId, position])
  // Target of Item's composite foreign key, so the database itself checks
  // that an Item's Level is in the Item's Collection at the copied position.
  @@unique([id, collectionId, position])
  @@map("level")
}

// Structure (FR-1.3, ADR 0003), backed by the database:
// - the composite foreign key to Level means the Level is in the Item's
//   Collection, and levelPosition is a copy of that Level's position;
// - the composite foreign key to the parent means the parent is in the same
//   Collection, and parentLevelPosition is a copy of the parent's position;
// - a hand-written CHECK (item_structure_check) says a top-Level Item has no
//   parent and any other Item's parent sits at the Level directly above.
// Level positions never change once Items exist (only the deepest, empty
// Level can be removed), so the copies can't go stale.
model Item {
  id                  String          @id @default(uuid(7))
  collectionId        String
  collection          Collection      @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  levelId             String
  levelPosition       Int
  // NoAction (checked at the end of the statement) rather than Restrict, so
  // deleting a Collection can cascade to its Levels and Items together.
  level               Level           @relation(fields: [levelId, collectionId, levelPosition], references: [id, collectionId, position], onDelete: NoAction)
  parentId            String?
  parentLevelPosition Int?
  parent              Item?           @relation("ItemChildren", fields: [parentId, collectionId, parentLevelPosition], references: [id, collectionId, levelPosition], onDelete: Cascade)
  children            Item[]          @relation("ItemChildren")
  overallRatings      OverallRating[]
  name                String
  // Items are listed by this. It defaults to creation order, so Episode 2
  // never comes before Episode 1; bulk creation of numbered children (a
  // later slice) relies on it.
  sortKey             BigInt          @default(autoincrement())
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@unique([id, collectionId, levelPosition])
  @@index([collectionId, parentId, sortKey])
  @@index([parentId])
  @@index([levelId])
  @@map("item")
}

// A User's standing opinion of an Item (FR-2.6); in this slice only its
// Verdict. One per (Item, User). The Verdict is stored as the raw value on the
// Item's Level's Overall Verdict scale: verdictNumber for a numeric scale,
// verdictLabel for a label scale, exactly one set (hand-written CHECK
// overall_rating_verdict_check). The 0–1 form is always computed with
// toUnitInterval from @repo/shared and never stored, so a rescale can't leave
// stale copies.
model OverallRating {
  id            String   @id @default(uuid(7))
  itemId        String
  item          Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  verdictNumber Float?
  verdictLabel  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([itemId, userId])
  @@index([userId])
  @@map("overall_rating")
}
