{
  "name": "repo",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "dev:web": "pnpm --filter @repo/web dev",
    "dev:mobile": "pnpm --filter @repo/mobile start",
    "db:migrate": "pnpm --filter @repo/web db:migrate",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "tokens": "pnpm --filter @repo/shared tokens"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
